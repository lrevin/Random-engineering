HOST=127.0.0.1
PORT=8788

# db:setup creates a NEW schema and runs Flyway migrate/validate. Never reset a service DB.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ppobgong_v2_test
# Optional CA certificate path; certificate verification stays enabled.
MYSQL_SSL_CA=

# Required in MySQL API mode. Generate at least 32 random bytes; never put in app env.
JWT_SECRET=

# Optional Flyway executable path; otherwise Flyway must be on PATH.
FLYWAY_EXECUTABLE=

# Kakao login (optional). Leave empty to turn Kakao login off. Never put these in the app.
# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret (사용 함으로 켰을 때만)
KAKAO_CLIENT_SECRET=
# 카카오 로그인 > Redirect URI 에 똑같이 등록할 주소
KAKAO_REDIRECT_URI=https://ppobgong.o-r.kr/auth/kakao/callback
