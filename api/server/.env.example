HOST=127.0.0.1
PORT=8788

# Set these for MySQL mode. Use a NEW dedicated test schema for db:setup.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ppobgong_v2_test
# Optional CA certificate path; certificate verification stays enabled.
MYSQL_SSL_CA=

# Required in MySQL API mode. Generate at least 32 random bytes; never put in app env.
JWT_SECRET=
