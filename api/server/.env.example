HOST=127.0.0.1
PORT=8788

# db:setup creates a NEW schema and runs Flyway migrate/validate. Never reset a service DB.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ppobgong_v2_test
# Optional CA certificate path; certificate verification stays enabled.
MYSQL_SSL_CA=

# Required in MySQL API mode. Generate at least 32 random bytes; never put in app env.
JWT_SECRET=

# Optional Flyway executable path; otherwise Flyway must be on PATH.
FLYWAY_EXECUTABLE=

# Kakao login (optional). Leave empty to turn Kakao login off. Never put these in the app.
# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret (사용 함으로 켰을 때만)
KAKAO_CLIENT_SECRET=
# 카카오 로그인 > Redirect URI 에 똑같이 등록할 주소
KAKAO_REDIRECT_URI=https://ppobgong.o-r.kr/auth/kakao/callback

# AdMob 보상형 광고 서버 측 확인(SSV). 필수: 우리 광고 단위 ID를 쉼표로. 비워 두면 광고 보상을 지급하지 않음.
ADMOB_REWARDED_UNITS=ca-app-pub-2812024386507663/1651172098,ca-app-pub-2812024386507663/3760274779
# 회원 요청용 MySQL 연결 풀 크기 (공개 문제 조회용 풀 10개와 별도)
MYSQL_POOL_SIZE=10

# 퀴즈 AI 서버(api/quiz-server)를 API 서버가 대신 부를 때 (앱에는 넣지 않음). 둘 다 있어야 /me/quiz 가 켜짐
QUIZ_SERVER_URL=
QUIZ_SERVER_TOKEN=
# 전체 요청을 IP마다 1분에 이만큼까지 (Nginx가 붙인 실제 주소 기준)
IP_RATE_LIMIT=1200
# (선택) Expo 계정에서 '푸시 보안'을 켰을 때만. 앱에는 넣지 않음
EXPO_ACCESS_TOKEN=

# 뽑공 프리미엄 월 구독 (토스페이먼츠 카드 자동결제). 둘 다 있어야 결제가 켜짐. 시크릿 키는 서버에만 (앱 · 저장소에 넣지 않음)
# 개발자센터의 'API 개별 연동 키' (자동결제는 test_ck / test_sk 로 시작하는 키, 실제 결제는 live_ck / live_sk)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 비밀번호 찾기 메일 (없으면 비밀번호 찾기가 꺼짐). 구글이면 smtp.gmail.com + '앱 비밀번호'
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=뽑공 <no-reply@example.com>
# 개발용: 1 이면 메일 대신 서버 로그에 확인 코드를 남김 (운영에서는 켜지 말 것)
MAIL_DEV_LOG=
