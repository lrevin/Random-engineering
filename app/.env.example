# 자체 MySQL API 주소가 필수입니다. 이 파일을 .env.local로 복사하세요.
# Android 에뮬레이터에서 PC 백엔드: http://10.0.2.2:8788
# 팀원용 APK는 빌드 전에 공통 HTTPS 서버 주소를 설정하세요.
EXPO_PUBLIC_API_URL=https://ppobgong.o-r.kr

# 퀴즈 AI 서버 (api/quiz-server). 비워 두거나 통신에 실패하면 AI 캐시·기본 은행·대체 연습 문제를 사용합니다.
# 안드로이드 에뮬레이터: adb reverse tcp:8787 tcp:8787 후 http://127.0.0.1:8787
EXPO_PUBLIC_QUIZ_SERVER_URL=
EXPO_PUBLIC_QUIZ_SERVER_TOKEN=

# 친구 · 1:1 배틀 서버 (api/SOCIAL_API.md). 비워 두면 친구 탭에 "서버 연결 필요"가 보입니다.
# 개발용 시험 서버: node api/mock-social/server.mjs → 안드로이드 에뮬레이터는 http://10.0.2.2:8790
EXPO_PUBLIC_SOCIAL_URL=

# 구글 AdMob 보상형 광고 (상점·배틀 탭 "광고 보고 톱니바퀴 받기").
# 비워 두면 구글이 공개한 시험용 광고를 씁니다. 실제 광고 단위 ID는 AdMob 콘솔에서 만든 뒤 넣으세요.
# 앱 ID(ca-app-pub-…~…)는 app.json 의 react-native-google-mobile-ads 설정을 바꿔야 합니다. (지금은 구글 시험용 앱 ID)
# Expo Go에서는 광고 SDK가 없어서 5초짜리 시험용 화면이 대신 나옵니다. 실제 광고는 개발 빌드(npx expo run:android)에서만 보입니다.
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
