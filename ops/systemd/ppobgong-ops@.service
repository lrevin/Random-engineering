[Unit]
Description=뽑공 운영 관리 %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/ppobgong-current/api/server
Environment=PATH=/home/ubuntu/.nvm/versions/node/v22.23.5/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/ppobgong/operations.env
ExecStart=/usr/bin/env node --env-file-if-exists=.env ../mysql/operations.mjs %i --apply
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=30min
